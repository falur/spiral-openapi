{
    "name": "gian-tiaga/spiral-openapi",
    "type": "library",
    "license": "MIT",
    "description": "Static OpenAPI generator for typed Spiral HTTP layers",
    "authors": [
        {
            "name": "Ildar Enakaev",
            "email": "ienakaev@ya.ru"
        }
    ],
    "require": {
        "php": ">=8.5",
        "nyholm/psr7": "^1.8",
        "nikic/php-parser": "^5.7",
        "phpstan/phpdoc-parser": "^2.3",
        "spiral/framework": "^3.16",
        "symfony/finder": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "gian-tiaga/phpstan-strict-rules": "^0.1.0",
        "php-cs-fixer/shim": "^3.95.23",
        "phpstan/phpstan": "^2.1.54",
        "phpunit/phpunit": "^13.1"
    },
    "autoload": {
        "psr-4": {
            "GianTiaga\\SpiralOpenApi\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GianTiaga\\SpiralOpenApi\\Tests\\": "tests"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "vendor/bin/phpunit",
        "qa": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "spiral/composer-publish-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "homepage": "https://github.com/falur/spiral-openapi",
    "support": {
        "issues": "https://github.com/falur/spiral-openapi/issues",
        "source": "https://github.com/falur/spiral-openapi"
    },
    "scripts-descriptions": {
        "cs": "Проверить стиль кода без изменения файлов",
        "cs:fix": "Исправить стиль кода",
        "phpstan": "Статический анализ максимального уровня",
        "test": "Тесты пакета",
        "qa": "Все блокирующие проверки пакета: стиль, анализ, тесты"
    }
}
